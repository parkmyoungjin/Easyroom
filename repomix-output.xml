```typescript
// reservationService.ts에 추가
async getMyReservationsOptimized(supabase: SupabaseClient, userId: string) {
  const { data, error } = await supabase.rpc('get_user_reservations_detailed', {
    p_user_id: userId
  });
  
  if (error) throw error;
  return data || [];
}

// roomService.ts에 추가
async getBookedSlots(supabase: SupabaseClient, roomId: string, date: Date) {
  const startDate = format(date, 'yyyy-MM-dd') + 'T00:00:00Z';
  const endDate = format(date, 'yyyy-MM-dd') + 'T23:59:59Z';
  
  const { data, error } = await supabase.rpc('get_reservations_for_period', {
    start_date: startDate,
    end_date: endDate
  });
  
  if (error) throw error;
  
  return (data || [])
    .filter(r => r.room_id === roomId && r.status !== 'cancelled')
    .map(r => ({
      id: r.id,
      start_time: r.start_time,
      end_time: r.end_time,
      title: r.title,
      user_name: r.user_name || '알 수 없음',
      is_mine: r.is_mine || false
    }));
}
```

