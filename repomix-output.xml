      <CardHeader>
        <CardTitle>예약 수정</CardTitle>
        <CardDescription>예약 정보를 수정하세요</CardDescription>
      </CardHeader>
      <CardContent>
        {/* 폼 내용 */}
      </CardContent>
    </Card>
  </div>
