              }}
            >
              닫기
            </Button>
          </Stack>
        </Drawer.Body>
      </Drawer>

      {/* 예약 취소 다이얼로그 */}
      {showCancelDialog && reservation && (
        <ReservationCancelDialog
          reservation={reservation}
          open={showCancelDialog}
          onOpenChange={handleCancelDialogClose}
        />
      )}
    </>
  );
}
