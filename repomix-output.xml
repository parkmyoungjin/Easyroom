    const quickCheckStart = <span class="cstat-no" title="statement not covered" >Date.now();</span>
    const quickCheck = <span class="cstat-no" title="statement not covered" >await quickEnvironmentCheck();</span>
    const quickCheckDuration = <span class="cstat-no" title="statement not covered" >Date.now() - quickCheckStart;</span>
&nbsp;
