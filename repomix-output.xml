<span class="cstat-no" title="statement not covered" >    <span class="missing-if-branch" title="if path not taken" >I</span>if (!paginationValidation.isValid) {</span>
<span class="cstat-no" title="statement not covered" >      logger.warn('Rooms API: 페이지네이션 파라미터 검증 실패', {</span>
