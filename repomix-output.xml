        description: '회의 시작 10분 전부터는 취소할 수 없습니다.',
      },
    },
  } as const;
&nbsp;
  const actionMessages = <span class="cstat-no" title="statement not covered" >messages[action];</span>
  const message = <span class="cstat-no" title="statement not covered" >actionMessages[reason as keyof typeof actionMessages];</span>
  
<span class="cstat-no" title="statement not covered" >  return message || {</span>
    title: `${action === 'edit' ? '수정' : '취소'} 실패`,
    description: '권한이 없거나 처리할 수 없는 상태입니다.',
  };
}
