<span class="cstat-no" title="statement not covered" >        steps.push(...this.getNetworkTroubleshootingSteps(error, environment));</span>
<span class="cstat-no" title="statement not covered" >        break;</span>
      
      default:
<span class="cstat-no" title="statement not covered" >        steps.push(...this.getGenericTroubleshootingSteps(error, environment));</span>
