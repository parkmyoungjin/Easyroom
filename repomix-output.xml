<span class="cstat-no" title="statement not covered" >      await deploymentIntegration.invalidateAllCaches();</span>
      
<span class="cstat-no" title="statement not covered" >      if (autoReload) {</span>
<span class="cstat-no" title="statement not covered" >        window.location.reload();</span>
