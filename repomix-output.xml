      </div>
      <Skeleton className="h-10 w-10" />
    </div>
    <div className="grid grid-cols-5 gap-2 mb-4">
      <Skeleton className="h-12 w-full" />
      <Skeleton className="h-12 w-full" />
      <Skeleton className="h-12 w-full" />
