    let serverValidation = <span class="cstat-no" title="statement not covered" >null;</span>
<span class="cstat-no" title="statement not covered" >    <span class="missing-if-branch" title="if path not taken" >I</span>if (!quickCheck || !criticalRequirements.overall) {</span>
      const validationStart = <span class="cstat-no" title="statement not covered" >Date.now();</span>
<span class="cstat-no" title="statement not covered" >      serverValidation = await validateServerStartup({</span>
        strictMode: environment === 'production',
        includeOptional: false,
        caller: 'health_check'
      });
    }
&nbsp;
    // Build health check results
    const checks = <span class="cstat-no" title="statement not covered" >{</span>
      environment: {
        status: quickCheck ? 'pass' : 'fail',
        message: quickCheck 
          ? 'Environment configuration is valid' 
          : 'Environment configuration has issues',
        duration: quickCheckDuration,
        lastChecked: timestamp
      } as HealthCheckResult,
      
      database: {
        status: criticalRequirements.database ? 'pass' : 'fail',
        message: criticalRequirements.database 
          ? 'Database configuration is valid' 
          : 'Database configuration is missing or invalid',
        duration: criticalCheckDuration,
        lastChecked: timestamp
      } as HealthCheckResult,
      
      auth: {
