          )}
        </div>
        
        <div className="text-center">
          <p className="text-xs text-gray-500">
            이메일이 도착하지 않았나요? 스팸 폴더도 확인해보세요.
          </p>
        </div>
      </Card.Section>
    </Card>
  )
}
