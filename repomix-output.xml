                  &lt;FormControl&gt;
                    &lt;Input
                      type="number"
                      {...field}
                      onChange={<span class="fstat-no" title="function not covered" >(e</span>) =&gt; <span class="cstat-no" title="statement not covered" >field.onChange(parseInt(e.target.value))}</span>
                    /&gt;
                  &lt;/FormControl&gt;
                  &lt;FormMessage /&gt;
                &lt;/FormItem&gt;
              )}
            /&gt;
&nbsp;
            &lt;FormField
              control={form.control}
              name="description"
              render={({ field }) =&gt; (
                &lt;FormItem&gt;
                  &lt;FormLabel&gt;설명 (선택)&lt;/FormLabel&gt;
                  &lt;FormControl&gt;
