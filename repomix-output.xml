<span class="cline-any cline-neutral">&nbsp;</span></td><td class="text"><pre class="prettyprint lang-js">/**
 * PWA Signup Utilities
 * Handles PWA-specific functionality for signup process including offline detection
 */
&nbsp;
import { getNetworkStatus, isNetworkError } from <span class="cstat-no" title="statement not covered" >'./auth-timeout';</span>
&nbsp;
export interface PWASignupState {
  isOnline: boolean;
  isPWA: boolean;
  canSignup: boolean;
