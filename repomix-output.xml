/**
 * 권한 오류에 대한 사용자 친화적인 메시지를 반환합니다
 */
export function <span class="cstat-no" title="statement not covered" ><span class="fstat-no" title="function not covered" >getPermissionErrorMessage(</span></span>
  action: 'edit' | 'cancel',
  reason: string
): { title: string; description: string } {
  const messages = <span class="cstat-no" title="statement not covered" >{</span>
    edit: {
      not_owner_or_admin: {
        title: '접근 권한이 없습니다',
