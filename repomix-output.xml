    console.log('✅ get_public_reservations RPC 함수 동작 확인');
    console.log(`📊 조회된 예약 수: ${data?.length || 0}개`);
    return true;
    
  } catch (error) {
    console.error('❌ RPC 함수 테스트 실패:', error.message);
    return false;
  }
}

async function testUserSchema() {
