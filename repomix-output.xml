              />
              
              <TextInput
                label="이름"
                placeholder="이름을 입력하세요"
                disabled={isLoading}
                {...form.register('name')}
                error={form.formState.errors.name?.message}
              />
              
              <TextInput
                label="부서"
                placeholder="부서를 입력하세요"
                disabled={isLoading}
                {...form.register('department')}
                error={form.formState.errors.department?.message}
              />
              
              <Button type="submit" fullWidth loading={isLoading}>
