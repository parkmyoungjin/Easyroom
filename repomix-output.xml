    const { data: rooms, error: roomsError } = await supabase
      .from('rooms')
      .select('name, is_active')
      .eq('is_active', true);

    if (roomsError) {
      throw new Error(`rooms 테이블 조회 실패: ${roomsError.message}`);
    }

    if (rooms && rooms.length >= 3) {
