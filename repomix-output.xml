<span class="cstat-no" title="statement not covered" >  <span class="missing-if-branch" title="if path not taken" >I</span>if (config.showMigrationMessages) {</span>
<span class="cstat-no" title="statement not covered" >    loginUrl.searchParams.set('migration', 'magic-link');</span>
<span class="cstat-no" title="statement not covered" >    loginUrl.searchParams.set('message', 'auth-method-changed');</span>
  }
  
