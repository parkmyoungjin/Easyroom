<span class="cstat-no" title="statement not covered" >      recommendations.push('Consider adding user_metadata for profile information');</span>
    } else {
      const metadata = <span class="cstat-no" title="statement not covered" >session.user.user_metadata;</span>
<span class="cstat-no" title="statement not covered" >      <span class="missing-if-branch" title="if path not taken" >I</span>if (!metadata.fullName &amp;&amp; !metadata.name) {</span>
<span class="cstat-no" title="statement not covered" >        recommendations.push('Consider adding fullName to user_metadata');</span>
      }
<span class="cstat-no" title="statement not covered" >      <span class="missing-if-branch" title="if path not taken" >I</span>if (!metadata.department) {</span>
<span class="cstat-no" title="statement not covered" >        recommendations.push('Consider adding department to user_metadata');</span>
      }
    }
  }
  
  // Check token expiration
<span class="cstat-no" title="statement not covered" >  <span class="missing-if-branch" title="if path not taken" >I</span>if (session.expires_at) {</span>
