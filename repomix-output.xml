 */
export function <span class="cstat-no" title="statement not covered" ><span class="fstat-no" title="function not covered" >isAdmin(u</span></span>ser: UserProfile): boolean {
<span class="cstat-no" title="statement not covered" >  return user.role === 'admin';</span>
