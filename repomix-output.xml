    const criticalCheckStart = <span class="cstat-no" title="statement not covered" >Date.now();</span>
    const criticalRequirements = <span class="cstat-no" title="statement not covered" >await validateCriticalRequirements('health_check');</span>
    const criticalCheckDuration = <span class="cstat-no" title="statement not covered" >Date.now() - criticalCheckStart;</span>
&nbsp;
