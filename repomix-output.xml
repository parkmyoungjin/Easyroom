    it('should handle multiple listeners', (done) => {
      let callCount = 0;
      const onAuthSuccess1 = jest.fn((state) => {
        if (state?.status === 'authenticated') {
          callCount++;
          if (callCount === 2) done();
        }
      });
      const onAuthSuccess2 = jest.fn((state) => {
        if (state?.status === 'authenticated') {
