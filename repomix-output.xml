<span class="cstat-no" title="statement not covered" >  return {</span>
    retry: <span class="fstat-no" title="function not covered" >(f</span>ailureCount: number, error: Error) =&gt; {
<span class="cstat-no" title="statement not covered" >      <span class="missing-if-branch" title="if path not taken" >I</span>if (!shouldRetry(error)) {</span>
