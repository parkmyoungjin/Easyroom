    const allPassed = <span class="cstat-no" title="statement not covered" >Object.values(checks).every(<span class="fstat-no" title="function not covered" >check =&gt; <span class="cstat-no" title="statement not covered" >c</span>heck.status === 'pass');</span></span>
    const anyFailed = <span class="cstat-no" title="statement not covered" >Object.values(checks).some(<span class="fstat-no" title="function not covered" >check =&gt; <span class="cstat-no" title="statement not covered" >c</span>heck.status === 'fail');</span></span>
    
    const overallStatus = <span class="cstat-no" title="statement not covered" >allPassed ? 'healthy' : anyFailed ? 'unhealthy' : 'degraded';</span>
&nbsp;
    // Build response
    const response: HealthCheckResponse = <span class="cstat-no" title="statement not covered" >{</span>
      status: overallStatus,
      timestamp,
      environment,
      version: process.env.npm_package_version,
      uptime: process.uptime ? process.uptime() * 1000 : Date.now() - startTime,
      checks
    };
&nbsp;
    // Add details if requested (development only for security)
<span class="cstat-no" title="statement not covered" >    <span class="missing-if-branch" title="if path not taken" >I</span>if (showDetails &amp;&amp; environment === 'development') {</span>
<span class="cstat-no" title="statement not covered" >      response.details = {</span>
