      const getNextPageParam = (lastPage: typeof mockLastPage) => {
        if (!lastPage.pagination?.has_more) {
          return undefined;
        }
        return lastPage.pagination.offset + lastPage.pagination.limit;
      };

      const nextPageParam = getNextPageParam(mockLastPage);
