              {/* ✅ [4. 최종 단계] 가져온 초기 데이터를 AuthProvider에 props로 주입 */}
              <AuthProvider initialSession={session} initialProfile={initialProfile}>
                {/* 2계층: 상태 소비 및 분기 계층 - 인증 상태에 따른 UI 분기만 담당 */}
                <AuthGatekeeper>
                  {children}
                </AuthGatekeeper>
                <AuthToastManager />
                <Toaster />
              </AuthProvider>
            </SupabaseProvider>
          </Providers>
        </ClientPolyfillManager>
      </body>
    </html>
  );
}
