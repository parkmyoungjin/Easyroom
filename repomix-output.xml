DO $$
BEGIN
    RAISE NOTICE '=== 5. 성능 최적화 확인 ===';
END $$;

-- auth_id 인덱스 존재 확인 (성능 최적화)
SELECT 
    CASE 
        WHEN COUNT(*) > 0 THEN '✅ auth_id 인덱스 존재 (성능 최적화)'
        ELSE '⚠️ auth_id 인덱스 없음 (성능 영향 가능)'
    END as index_check
FROM pg_indexes 
WHERE tablename = 'users' 
AND indexdef LIKE '%auth_id%';

