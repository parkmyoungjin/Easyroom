      } else {
        console.error('[RootLayout] Server: Failed to load profile:', error);
      }
    } catch (error) {
      console.error('[RootLayout] Server: Exception during profile fetch:', error);
    }
  } else {
    console.log('[RootLayout] Server: No session found');
  }
