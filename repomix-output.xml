        user_record.auth_id,
        user_record.id,
        user_record.employee_id,
        user_record.email,
        user_record.name,
        user_record.department,
        user_record.role,
        user_record.created_at,
        user_record.updated_at
    INTO result;

    RETURN result; -- ✅ [핵심 계약 이행] 'TABLE'이 아닌, 계약된 '단일 객체'를 반환
END;
$$;

