<span class="cstat-no" title="statement not covered" >  <span class="missing-if-branch" title="if path not taken" >I</span>if (params.error) {</span>
<span class="cstat-no" title="statement not covered" >    loginUrl.searchParams.set('error', params.error);</span>
  }
  
<span class="cstat-no" title="statement not covered" >  return loginUrl.toString();</span>
}
