  title={`안녕하세요, ${userProfile.name}님!`}
  showUserMenu
  showLogo
/>

// 인증 페이지  
<AppHeader 
  variant="minimal" 
  showLogo 
/>

// 키오스크
<AppHeader 
  variant="kiosk"
  title="실시간 예약 현황"
  showAuthButtons
/>
```

