{
  "ignore": [
    ".github/**",
    "coverage/**",
    "node_modules/**",
    "*.md",
    "*.sql",
    "*.bat",
    "rollback-*/**",
    "test-*/**",
    "ci-reports/**"
  ],
  "ignoreDependencies": [
    "@types/*"
  ],
  "entry": [
    "src/app/**/*.{js,jsx,ts,tsx}",
    "src/components/**/*.{js,jsx,ts,tsx}",
    "src/lib/**/*.{js,jsx,ts,tsx}",
    "src/hooks/**/*.{js,jsx,ts,tsx}",
    "src/utils/**/*.{js,jsx,ts,tsx}",
    "next.config.ts",
    "tailwind.config.ts"
  ]
}